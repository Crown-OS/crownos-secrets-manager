# The hardening uses only seccomp and resource limits. In a user unit, every
# file system option (ProtectSystem=, ProtectHome=, PrivateTmp=, ReadWritePaths=
# and the like) puts the daemon in its own user namespace. The kernel then
# refuses to let it read /proc/<pid>/exe of a caller, and every caller becomes
# unidentified.
[Unit]
Description=CrownOS secrets daemon
ConditionPathExists=!/run/archiso
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/crownos-secretsd
Restart=on-failure
RestartSec=3
UMask=0077
LimitCORE=0
MemorySwapMax=0
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
