# The hardening uses only seccomp and resource limits, for two reasons.
# 1. In a user unit, each file system option (ProtectSystem=, ProtectHome=,
#    PrivateTmp=, ReadWritePaths= and the like) puts the daemon in a new user
#    namespace. Reading /proc/<pid>/exe of a caller is a ptrace-read check, and
#    the kernel refuses it across user namespaces. Every caller would then be
#    unidentified.
# 2. The user owns that namespace, so any process of the user outside it has
#    CAP_SYS_PTRACE inside it. Such a process could attach to the daemon in
#    spite of PR_SET_DUMPABLE=0.
# The daemon starts run templates in bubblewrap. Children get the same seccomp
# filter, so bwrap needs @mount, the namespace types below and AF_NETLINK (it
# sets up the loopback device of a new network namespace).
# MemoryDenyWriteExecute= stays off: children get it too, and it breaks JIT
# runtimes such as node in a run template.
# MemoryMax= leaves room for the largest Argon2id cost that a vault header may
# ask for (256 MiB).
[Unit]
Description=CrownOS secrets daemon
ConditionPathExists=!/run/archiso
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/crownos-secretsd
Restart=on-failure
RestartSec=3
UMask=0077
LimitCORE=0
MemorySwapMax=0
MemoryMax=384M
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=user pid ipc uts net mnt cgroup
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount

[Install]
WantedBy=default.target
